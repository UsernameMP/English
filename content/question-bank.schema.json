{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-sprint.local/question-bank.schema.json",
  "title": "Olympiad Content Pack",
  "type": "object",
  "required": ["schema_version", "bank_id", "content_version", "pack", "questions"],
  "properties": {
    "schema_version": {"type": "string"},
    "bank_id": {"type": "string"},
    "content_version": {"type": "string"},
    "pack": {
      "type": "object",
      "required": ["id", "subject", "grade_min", "grade_max", "season", "title", "subtitle"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "grade_min": {"type": "integer", "minimum": 1},
        "grade_max": {"type": "integer", "minimum": 1},
        "competition": {"type": "string"},
        "region": {"type": "string"},
        "season": {"type": "string"},
        "title": {"$ref": "#/$defs/localizedText"},
        "subtitle": {"$ref": "#/$defs/localizedText"}
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "subject", "grade_min", "grade_max", "interaction", "mode", "skills", "knowledge", "prompt", "answer", "feedback", "review"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "minLength": 1},
          "grade_min": {"type": "integer", "minimum": 1},
          "grade_max": {"type": "integer", "minimum": 1},
          "interaction": {"enum": ["single_choice", "multi_choice", "true_false", "matching", "sequence", "numeric", "free_response"]},
          "mode": {"enum": ["practice", "grammar", "reading", "listening", "story"]},
          "skills": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "tags": {"type": "array", "items": {"type": "string"}},
          "knowledge": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "weight"],
              "properties": {
                "id": {"type": "string"},
                "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
              }
            }
          },
          "prompt": {"type": "string", "minLength": 1},
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": {
                "id": {"type": "string"},
                "text": {"type": "string"}
              }
            }
          },
          "answer": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "feedback": {
            "type": "object",
            "required": ["short", "full", "rule"],
            "properties": {
              "short": {"$ref": "#/$defs/localizedText"},
              "full": {"$ref": "#/$defs/localizedText"},
              "rule": {"$ref": "#/$defs/localizedText"}
            }
          },
          "review": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {"enum": ["draft", "review", "verified", "published", "rejected"]}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string"}
    }
  }
}
