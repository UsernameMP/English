          "en": "AND is true only when both operands are true.",
          "ru": "AND истинно, только когда истинны оба операнда."
        },
        "full": {
          "en": "The second operand is already true, so the expression copies A.",
          "ru": "Второй операнд уже истинен, поэтому выражение совпадает с A."
        },
        "rule": {
          "en": "true AND true = true.",
          "ru": "true AND true = true."
